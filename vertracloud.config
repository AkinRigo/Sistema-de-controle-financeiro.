# Vertra Cloud: um app só. O backend (FastAPI) também entrega o site montado.
# Publicar a partir da branch "deploy" (o GitHub Actions monta o site e atualiza essa branch).
NAME=no-corre-das-notas
DESCRIPTION=No Corre das Notas: controle financeiro (API + site)
LANGUAGE=python
VERSION=recommended
MAIN=backend/src/painel/main.py
MEMORY=512
AUTORESTART=true
SUBDOMAIN=nocorre
START=cd backend && alembic upgrade head && PAINEL_FRONTEND_DIST=../frontend/dist uvicorn painel.main:app --host 0.0.0.0 --port 80 --proxy-headers --forwarded-allow-ips=*
