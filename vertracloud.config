# Vertra Cloud: um app só. O backend (FastAPI) também entrega o site montado.
# Publicar a partir da branch "deploy" (o GitHub Actions monta o site e atualiza essa branch).
NAME=no-corre-das-notas
DESCRIPTION=No Corre das Notas: controle financeiro (API + site)
LANGUAGE=python
VERSION=recommended
MAIN=start.py
MEMORY=512
AUTORESTART=true
SUBDOMAIN=nocorre
START=python start.py
